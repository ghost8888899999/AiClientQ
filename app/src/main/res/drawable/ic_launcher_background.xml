<?xml version="1.0" encoding="utf-8"?>
<!--
    adaptive icon 背景层：108×108 铺满，由系统按厂商遮罩裁成圆形/方形/水滴形。
    与 ic_lgns 的背景用同一条渐变，保证桌面图标与图标预览观感一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="90"
                android:endY="108"
                android:startX="18"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FF22355C"
                    android:offset="0" />
                <item
                    android:color="#FF111E36"
                    android:offset="0.55" />
                <item
                    android:color="#FF060A12"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
