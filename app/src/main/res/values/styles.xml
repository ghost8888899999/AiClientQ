<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 齿轮菜单弹窗：缩放淡入 + 淡出 -->
    <style name="PopMenuAnim">
        <item name="android:windowEnterAnimation">@anim/pop_menu_in</item>
        <item name="android:windowExitAnimation">@anim/pop_menu_out</item>
    </style>

    <style name="AppDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="DialogInputStyle">
        <item name="android:background">@drawable/bg_input_focused</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textColorHint">#9E9E9E</item>
    </style>

    <style name="DialogTitleStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogSubtitleStyle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#757575</item>
    </style>

    <style name="AppSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:dropDownWidth">match_parent</item>
        <item name="android:popupBackground">@color/white</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>

    <style name="AppSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="thumbTint">@color/switch_thumb</item>
    </style>
</resources>