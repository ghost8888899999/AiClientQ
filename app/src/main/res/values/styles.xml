<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="popup_menu_item">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="AppDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="DialogInputStyle">
        <item name="android:background">@drawable/bg_input_focused</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textColorHint">#9E9E9E</item>
    </style>

    <style name="DialogTitleStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogSubtitleStyle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#757575</item>
    </style>
</resources>