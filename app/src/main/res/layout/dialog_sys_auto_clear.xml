<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_timer_svg"
            android:layout_marginEnd="10dp" />

        <TextView
            style="@style/DialogTitleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动清除配置" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:background="#FFF8E1"
        android:padding="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_warning_svg"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="系统最短15分钟触发；受省电策略影响可能延迟；打开APP会立即校验并清除"
            android:textColor="#E65100"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_auto_enable"
        style="@style/AppSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启用自动清除"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:textColor="#212121" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <EditText
            android:id="@+id/et_auto_clear_val"
            style="@style/DialogInputStyle"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="数值"
            android:inputType="number"
            android:gravity="center"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/sp_time_unit"
            style="@style/AppSpinner"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_auto_clear_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="当前：关闭自动清除"
        android:textSize="13sp"
        android:textColor="#757575" />

</LinearLayout>