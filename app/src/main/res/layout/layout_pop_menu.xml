<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_window_bg"
    android:minWidth="0dp"
    android:maxWidth="220dp"
    android:paddingStart="1dp"
    android:paddingEnd="1dp">

    <!-- 私钥管理 -->
    <RelativeLayout
        android:id="@+id/group_key_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:text="私钥管理"
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:gravity="center_vertical"/>

        <ImageView
            android:id="@+id/iv_arrow_key"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_expand_svg"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/group_key_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/menu_add_key" style="@style/popup_menu_item"/>
        <TextView android:id="@+id/menu_batch_fund" style="@style/popup_menu_item"/>
    </LinearLayout>

    <!-- 分组管理 -->
    <RelativeLayout
        android:id="@+id/group_mgmt_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:text="分组管理"
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:gravity="center_vertical"/>

        <ImageView
            android:id="@+id/iv_arrow_mgmt"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_expand_svg"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/group_mgmt_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/menu_add_group" style="@style/popup_menu_item"/>
    </LinearLayout>

    <!-- 日志管理 -->
    <RelativeLayout
        android:id="@+id/group_log_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:text="日志管理"
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:gravity="center_vertical"/>

        <ImageView
            android:id="@+id/iv_arrow_log"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_expand_svg"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/group_log_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/menu_view_log" style="@style/popup_menu_item"/>
    </LinearLayout>

    <!-- 自动清除配置 -->
    <RelativeLayout
        android:id="@+id/group_auto_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:text="自动清除配置"
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:gravity="center_vertical"/>

        <ImageView
            android:id="@+id/iv_arrow_auto"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_expand_svg"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/group_auto_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/menu_sys_schedule_setting" style="@style/popup_menu_item"/>
    </LinearLayout>

    <!-- 竞技场入场模式 -->
    <RelativeLayout
        android:id="@+id/group_mode_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:text="竞技场入场模式"
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:gravity="center_vertical"/>

        <ImageView
            android:id="@+id/iv_arrow_mode"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_expand_svg"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/group_mode_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/menu_mode_flexible" style="@style/popup_menu_item"/>
        <TextView android:id="@+id/menu_mode_together" style="@style/popup_menu_item"/>
    </LinearLayout>

    <!-- 锦标赛统计 -->
    <RelativeLayout
        android:id="@+id/group_champ_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:text="锦标赛统计"
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:gravity="center_vertical"/>

        <ImageView
            android:id="@+id/iv_arrow_champ"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_expand_svg"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/group_champ_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/menu_championship_stats" style="@style/popup_menu_item"/>
        <TextView android:id="@+id/menu_migrate_addresses" style="@style/popup_menu_item"/>
    </LinearLayout>

</LinearLayout>
