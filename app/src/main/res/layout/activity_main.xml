<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <!-- 顶部栏：标题+右上角齿轮SVG按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="竞技场批量工具"
            android:textSize="20sp"
            android:textStyle="bold" />
        <!-- 齿轮SVG按钮 内联矢量，无需图片资源 -->
        <ImageButton
            android:id="@+id/btn_setting_gear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多设置菜单"
            android:src="@drawable/ic_gear_svg" />
    </RelativeLayout>
    <!-- 安全风险提醒按钮（保留在主界面） -->
    <Button
        android:id="@+id/btn_security_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#D32F2F"
        android:textColor="#ffffff"
        android:text="⚠安全风险提醒(必看)" />
    <TextView
        android:id="@+id/tv_count_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="共 0 条密钥"
        android:textColor="#C62828"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />
    <!-- 密钥列表：带序号，自己维护勾选，choiceMode=none -->
    <ListView
        android:id="@+id/lv_cipher_keys"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:choiceMode="none" />
    <!-- 【主界面4个执行按钮】 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/btn_batch_enter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:backgroundTint="#1976D2"
            android:textColor="#ffffff"
            android:text="批量入场" />
        <View android:layout_width="6dp" android:layout_height="0dp" />
        <Button
            android:id="@+id/btn_batch_claim"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:backgroundTint="#1976D2"
            android:textColor="#ffffff"
            android:text="批量领取" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <Button
            android:id="@+id/btn_full_workflow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="完整工作流" />
        <View android:layout_width="6dp" android:layout_height="0dp" />
        <Button
            android:id="@+id/btn_reset_task"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="强制重置任务进度" />
    </LinearLayout>
    <!-- 日志区域 已补充id scrollView -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
